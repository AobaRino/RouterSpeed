#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

start_service() {
	local enabled client interface
	config_load router_speed
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	/usr/libexec/router-speed-control --validate || return 1
	config_get client main client
	config_get interface main interface
	mkdir -p /tmp/router-speed
	chmod 700 /tmp/router-speed
	rm -f /tmp/router-speed/status.json
	procd_open_instance
	procd_set_param command /usr/libexec/router-speed-collector --interface "$interface" --client "$client" --state-file /tmp/router-speed/status.json --quiet
	# A missing dae map can occur during boot. Wait 10 seconds between attempts;
	# bounded retries prevent a persistent incompatibility from looping forever.
	procd_set_param respawn 3600 10 12
	procd_set_param nice 10
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_set_param term_timeout 5
	procd_close_instance
}

stop_service() {
	rm -f /tmp/router-speed/status.json
}

service_triggers() {
	procd_add_reload_trigger router_speed
}
